# AIO_runtime_auth=
# AIO_runtime_namespace=
# AIO_runtime_apihost=

## WKND Commerce configuration (non-secret)
WKND_AUTH0_ISSUER=https://dev-g4kzp3zwgwzs8oha.us.auth0.com/
WKND_AUTH0_AUDIENCE=https://wknd-aero-api.jaggah.workers.dev
WKND_AUTH0_CLIENT_ID=ULTyS938dUNMhSXTjvLXr3b8ZrGOGhyM
WKND_ALLOWED_ORIGINS=https://wknd-adventures.run.place,https://*--masterclass-demo--znikolovski.aem.page,https://*--masterclass-demo--znikolovski.aem.live,http://localhost:3000,http://localhost:3002
WKND_SITE_ORIGIN=https://wknd-adventures.run.place
## Recovery email cart destination: set separately for each workspace; no default.
## Production: https://wknd-adventures.run.place/shop/cart
## Stage: the URL of a storefront configured for Stage Commerce.
WKND_SHOP_CART_URL=
WKND_PLACEHOLDER_IMAGE=https://wknd-adventures.run.place/default-meta-image.png
WKND_ADMIN_IMS_ORG=28260E2056581D3B7F000101@AdobeOrg
WKND_AEM_AUTHOR_URL=https://author-p115476-e1135027.adobeaemcloud.com
WKND_AEM_PRODUCTS_ROOT=/content/dam/wknd-adventures/products
WKND_CONTENT_AI_URL=https://author-p115476-e1135027.adobeaemcloud.com/adobe/contentAI
WKND_CONTENT_AI_SOURCE=wknd-adventures
WKND_HLX_ORG=znikolovski
WKND_HLX_SITE=masterclass-demo

## Secret — Edge Delivery site API key with the publish role (POST /config/{org}/sites/{site}/apiKeys.json)
WKND_HLX_ADMIN_API_KEY=
## WKND LLM app (ChatGPT shop tools) → storefront-graphql delegated shopper assertions.
# Issuer is the LLM app's MCP resource URL; the secret (>= 32 bytes) must equal the LLM app's
# WKND_COMMERCE_ASSERTION_SECRET variable. Leave empty to disable delegation.
WKND_MCP_DELEGATION_ISSUER=https://28538-wkndsherpa.adobeio-static.net/api/v1/web/llm-apps/mcp
WKND_MCP_DELEGATION_SECRET=
## CX Coworker operator MCP (separate from shopper delegation above).
# A random base64url secret (32+ random bytes, 43..128 chars). Never put it in a URL.
WKND_COMMERCE_MCP_SECRET=
# Trusted integration namespace, not verified IMS user/org membership. Keep stable.
WKND_COMMERCE_MCP_ORG=
# Optional exact comma-separated browser origins. Empty permits only requests without Origin.
WKND_COMMERCE_MCP_ALLOWED_ORIGINS=
# Enable only after approved real-DB primitive verification and promotion migration.
WKND_MCP_PROMOTION_WRITES_ENABLED=false
# Base64 encoding of exactly 32 random bytes; rotation invalidates promotion pagination cursors.
WKND_PROMOTION_CURSOR_KEY=
# Independent protected-recovery gate: keep false until actual DB redemption guarantees are proven.
WKND_RECOVERY_REDEMPTION_VERIFIED=false
# wknd.promotions/v2 selection gate: best-saving | (unset = v1 explicit-coupon precedence)
WKND_PROMOTION_SELECTION=
# Recovery email runs (admin Promotions screen): Brevo template, test-recipient allowlist, daily cap
WKND_BREVO_RECOVERY_TEMPLATE_ID=
WKND_RECOVERY_EMAIL_ALLOWLIST=
WKND_RECOVERY_EMAIL_DAILY_BUDGET=50
# Optional Brevo suppression webhook bearer credential. Empty disables webhook access.
WKND_BREVO_WEBHOOK_TOKEN=
# Local migration script credentials; never exposed as MCP tool inputs.
PROMOTIONS_DB_CLIENT_ID=
PROMOTIONS_DB_CLIENT_SECRET=
PROMOTIONS_DB_ORG_ID=
PROMOTIONS_DB_SCOPES=
DB_REGION=amer
# PDP prerender: false = preview only (no publish); the overlay URL is warmed before bulk jobs
WKND_PDP_PUBLISH=true
WKND_PDP_MARKUP_URL=https://28538-wkndcommerce-stage.adobeioruntime.net/api/v1/web/commerce/pdp-markup
